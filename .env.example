# ==============================================================================
# Variáveis de Ambiente para Orquestração Docker Compose - Dictadle (US-167)
# Copie este arquivo para .env na raiz do projeto caso deseje customizar valores
# ==============================================================================

# --- Banco de Dados PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dictadle_db
DB_HOST=db
DB_PORT=5432
# Porta exposta no host para acesso externo (ex.: DBeaver/pgAdmin sem conflitar com Postgres nativo na 5432)
DB_EXTERNAL_PORT=5433

# --- Backend (Flask / Gunicorn) ---
FLASK_ENV=production
SECRET_KEY=dictadle_docker_production_secret_key
BACKEND_PORT=5000
DEPLOYMENT_SLOT=blue
APP_VERSION=2.0.0
INSTANCE_READY=true

# --- Seed Administrativo Automático na Subida ---
SEED_ADMIN_ON_BOOT=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dictadle.com
ADMIN_PASSWORD=Admin12345

# --- Frontend (React / Vite / Nginx) ---
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080
VITE_API_URL=/api
